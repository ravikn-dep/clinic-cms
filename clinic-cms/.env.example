# Copy to .env and adjust for your machine:
#   copy .env.example .env

# Required — session signing (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Required — MySQL (create database first: CREATE DATABASE clinic_cms;)
DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/clinic_cms

# Optional app identifier (defaults to clinic-cms)
VITE_APP_ID=clinic-cms

# Optional — full tRPC URL if API is on a different host
# VITE_TRPC_URL=https://your-domain.example/api/trpc

PORT=3000

# --- File storage (pick one) ---
# Local disk (default when S3 is not set): files saved under clinic-cms/uploads/
# S3-compatible (AWS, MinIO, Cloudflare R2):
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://minio.example.com   # optional, for MinIO

# --- Optional AI (Ambient Scribe, PO OCR) — OpenAI-compatible API ---
# AI_API_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...

# --- Optional Google Maps ---
# GOOGLE_MAPS_API_KEY=

# --- Optional owner alerts (Slack/Discord webhook JSON POST) ---
# NOTIFY_WEBHOOK_URL=

# --- Optional Google Drive archive (see docs/ARCHIVE_GOOGLE_DRIVE.md) ---
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=https://your-domain.example/api/archive/google/callback
# GOOGLE_DRIVE_FOLDER_ID=
# ARCHIVE_CRON_ENABLED=true
# ARCHIVE_INTERVAL_WEEKS=6

# Do NOT use Manus OAuth — login is always /login (username/password).
