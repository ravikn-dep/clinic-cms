# Copy to .env and adjust for your machine:
#   copy .env.example .env

# Required — session signing (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Required — MySQL (create database first: CREATE DATABASE clinic_cms;)
DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/clinic_cms

# Optional (defaults to clinic-cms-local if omitted)
VITE_APP_ID=clinic-cms-local

# Optional — full tRPC URL if API is on a different host (usually leave unset on Manus)
# VITE_TRPC_URL=https://your-preview.manus.computer/api/trpc

# Optional
PORT=3000

# Optional legacy Manus / Forge integrations (not needed for username/password login)
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
